# Copia este archivo a ".env" (mismo folder) y llena los valores de tu
# proyecto de Supabase: Dashboard > Project Settings > API.
#
# Cloud es el modo predeterminado y falla cerrado si falta una credencial.
VITE_APP_MODE=cloud

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Solo para desarrollo local explícito (nunca producción):
# VITE_APP_MODE=demo
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
