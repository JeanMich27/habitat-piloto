# Copia este archivo a ".env" (mismo folder) y llena los valores de tu
# proyecto de Supabase: Dashboard > Project Settings > API.
#
# Si dejas este archivo vacío o no creas el .env, la app sigue funcionando
# en "modo local" (cada quien ve solo sus propios datos, guardados en su
# navegador) — útil para probar sin backend, pero NO comparte datos entre
# los 10 testers.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
