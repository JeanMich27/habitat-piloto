# Frontend de desarrollo. Copia este archivo a `.env` y usa EXCLUSIVAMENTE
# las credenciales públicas de HABITAT DEV. Producción se configura en Vercel,
# nunca en este archivo ni en el repositorio.
VITE_APP_MODE=cloud
VITE_SUPABASE_URL=https://REF_HABITAT_DEV.supabase.co
VITE_SUPABASE_ANON_KEY=ANON_KEY_PUBLICA_DE_HABITAT_DEV

# Solo para desarrollo local explícito (nunca producción):
# VITE_APP_MODE=demo
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Nunca agregar aquí SUPABASE_SERVICE_ROLE_KEY, database passwords, access
# tokens ni valores del proyecto PROD. Las variables VITE_* son públicas.
