# Frontend. Hay UN SOLO proyecto Supabase (ver AGENTS.md): el mismo que usa
# producción. Estas variables VITE_* son públicas por diseño — viajan al
# navegador — y la anon key no da acceso a nada que la RLS no permita.
#
# Copia este archivo a `.env` y pon los valores reales del proyecto.
VITE_APP_MODE=cloud
VITE_SUPABASE_URL=https://REF_DEL_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=ANON_KEY_PUBLICA

# Solo para trabajar sin base, con datos de mentira en memoria:
# VITE_APP_MODE=demo

# NUNCA pongas aquí SUPABASE_SERVICE_ROLE_KEY, contraseñas de base, access
# tokens ni llaves de EasyBroker/Meta/Gemini. Esos viven en los secretos del
# proyecto Supabase y en los secrets de GitHub Actions.
